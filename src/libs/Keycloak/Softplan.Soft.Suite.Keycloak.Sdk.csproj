<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Softplan.Soft.Suite.Keycloak.Sdk</AssemblyName>
    <RootNamespace>Softplan.Soft.Suite.Keycloak.Sdk</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Label="NuGet">
    <PackageId>Softplan.Soft.Suite.Keycloak</PackageId>
    <Title>Keycloak Admin REST API .NET SDK</Title>
    <Description>Modern, strongly typed .NET SDK for the Keycloak Admin REST API, generated from OpenAPI with AutoSDK.</Description>
    <PackageTags>keycloak;identity;iam;admin;rest;api;client;sdk;dotnet;openapi;autosdk</PackageTags>
    <PackageProjectUrl>https://github.com/softplan/softplan-soft-suite-keycloak-sdk-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/softplan/softplan-soft-suite-keycloak-sdk-dotnet.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
</Project>
